# ---------------------------------------------------------------------------
# Lunar Lander AI - .gitignore
# Rule of thumb: everything generated by running the project is ignored.
# ---------------------------------------------------------------------------

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/
ENV/
.conda/

# --- Python bytecode and build output --------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# --- Tooling caches --------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Generated artifacts ---------------------------------------------------
# Training logs (regenerated by scripts/train.py)
logs/*.csv
logs/*.json
logs/*.jsonl
logs/*.log
logs/job_*.yaml
logs/output_*.txt
logs/stage3_study_*.txt
logs/stop_*
logs/dashboard_evaluation.txt
logs/**/*.csv
logs/**/*.json

# Model checkpoints (regenerated by training; 100s of KB to a few MB each)
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.tar
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.tar
checkpoints/**/*.tmp

# Plots, videos, reports
results/*.png
results/*.jpg
results/*.svg
results/*.pdf
results/*.mp4
results/*.gif
results/*.json
results/*.md
results/*.csv
results/gallery/

# Raw data dumps
data/*.npz
data/*.npy
data/*.csv

# --- Keep the empty folder skeleton in git ---------------------------------
!**/.gitkeep

# --- Editors and operating systems -----------------------------------------
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# --- Secrets / local environment -------------------------------------------
# This project needs no API keys or credentials. If you ever add one,
# copy .env.example to .env and it will stay untracked.
.env
.env.*
!.env.example
